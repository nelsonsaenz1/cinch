# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
# No trailing slash: worktrees symlink node_modules rather than installing it,
# and a directory pattern does not match a symlink of the same name.
node_modules

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Supabase CLI local state. `.temp/` holds the linked project's pooler URL,
# which embeds the database connection string — never commit it.
supabase/.temp/
supabase/.branches/

# Vercel
.vercel

# Design handoff archives — extracted into docs/, the zips stay local
*.zip
handoff/

# Founder design drops — raw Claude Design exports live locally, canon is docs/design/
/Design zips:pngs/
/*Atlas-selection*.png
/*Atlas*.png
/*StateAtlas/

# Extracted references for the redesign wave. 68MB of PNG sheets and per-atlas
# garment photography, reproducible from the zips beside them, so the bytes stay
# out of history. Agents read them by absolute path — a worktree checkout does
# not need them, and MANIFEST.md (tracked) is the part worth keeping.
/design-refs/html/
/design-refs/png/

# marketing binaries — keep the register and specs, ignore the rest
marketing/**
!marketing/**/
!marketing/**/*.md
!marketing/**/*.csv

# Nested agent worktrees — full repo checkouts, never committable.
.worktrees/

# Generated PDF/render output from the design sessions. Untracked artifacts that
# would otherwise dirty the tree on every `eas update` — and a dirty tree is how
# a bundle stops being provably equal to HEAD.
output/
tmp/

# Screenshot matrix output (scripts/screenshot-matrix.mjs). Runs are local
# evidence, not artifacts — a committed baseline would go stale on every OS bump.
shots/
