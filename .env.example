# Copy to .env.local and fill in. Committed as a template — never put real
# values here.
#
# EXPO_PUBLIC_* is inlined into the bundle and is public by construction.
# Anything genuinely secret (Supabase secret key, Anthropic API key) lives in
# Edge Function secrets and is never referenced from client code.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PostHog public client configuration.
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
