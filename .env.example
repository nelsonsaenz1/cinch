# Copy to .env.local and fill in. Committed as a template — never put real
# values here.
#
# EXPO_PUBLIC_* is inlined into the bundle and is public by construction.
# Anything genuinely secret (Supabase secret key, Anthropic API key) lives in
# Edge Function secrets and is never referenced from client code.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Superwall's iOS key, from Settings -> Keys in the Superwall dashboard. Public
# by construction, like the Supabase key above: entitlements are decided
# server-side from App Store Server Notifications, so this identifies the
# project and nothing else. Nothing to do with App Store Connect — it exists as
# soon as you create a Superwall project, long before the app is published.
#
# Optional. Leave it blank and the app runs with paywalls disabled — every
# feature works and nothing ever prompts to subscribe.
EXPO_PUBLIC_SUPERWALL_API_KEY_IOS=

# PostHog product analytics. The project token is publishable (like the
# Supabase anon key) — it identifies the project, it cannot read data.
# Leave blank to disable analytics entirely; every feature still works.
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
